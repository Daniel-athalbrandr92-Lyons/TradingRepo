/*| [Legend:Module=RiskManager; Purpose=Position; Security=High]            |                                    |                              |                                       |                                 |*/
class CRiskManager { private: double r; public: CRiskManager(double risk) : r(risk) {} double CalcLot(double v) { return v * r; } };
